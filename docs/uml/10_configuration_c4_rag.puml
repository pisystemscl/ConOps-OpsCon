@startuml
/' Version restructuree : rectangles = traitements, fleches = flux d'information '/
title Configuration C4 - LLM + RAG - Flux de traitements

left to right direction
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam roundcorner 10
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 75
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultTextAlignment center
skinparam TitleFontSize 25
skinparam TitleFontStyle bold
skinparam TitleFontColor #0F172A
skinparam ArrowColor #475569
skinparam ArrowThickness 2
skinparam ArrowFontName Arial
skinparam ArrowFontSize 12
skinparam ArrowFontColor #334155
skinparam ArrowFontBackgroundColor #F8FAFC
skinparam interfaceBackgroundColor #FFFFFF
skinparam interfaceBorderColor #64748B
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #475569
  FontColor #0F172A
  FontSize 15
  FontStyle plain
  BorderThickness 2
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #CBD5E1
  FontColor #334155
  FontSize 13
}

<style>
  element {
    Padding 12
    Margin 5
  }
  arrow {
    FontSize 12
    FontColor #334155
    LineColor #475569
    LineThickness 2
  }
  legend {
    Padding 12
    Margin 10
  }
</style>

() " " as IN1
() " " as IN2
() " " as IN3
() " " as TEMPLATE

rectangle "<b>EXTRAIRE LES TEXTES</b>\n\nLecture page par page\nOCR des pages numerisees\nConservation des sources et pages" as A #E0F2FE
rectangle "<b>CONSTRUIRE LE CONTEXTE RAG</b>\n\nDecoupage des references en passages\nCreation des embeddings et index Chroma\nRecherche par similarite vectorielle" as B #E0F2FE
rectangle "<b>GENERER L'ANALYSE DU DOCUMENT</b>\n\nConstruction du prompt C4 enrichi\nExtraction des rubriques et preuves\nTraitement par Ollama" as C #EDE9FE
rectangle "<b>VALIDER LE SCHEMA JSON</b>\n\nValidation ConOpsAnalysis\nControle des champs obligatoires\nReparation si necessaire" as D #FEF3C7
rectangle "<b>EVALUER L'ANALYSE</b>\n\nCalcul deterministe avec Python\nCompletude, preuves et grounding\nScore, verdict et recommandations" as E #ECFDF5
rectangle "<b>EXPORTER LES RESULTATS</b>\n\nSerialisation des resultats\nGeneration des livrables" as F #DCFCE7

() "JSON" as JSON
() "CSV" as CSV
() "SysML" as SYSML

IN1 --> A : PDF cible\nConOps / OpsCon
IN2 --> A : Reference\nConOps
IN3 --> A : Reference\nOpsCon
A --> B : Textes extraits / OCR\nsources et pages
B --> C : Passages RAG\nsource, page, similarite
TEMPLATE --> C : Template ConOps\nrubriques attendues
C --> D : Analyse JSON brute\npreuves et citations RAG
D --> E : JSON valide et repare\nconforme a ConOpsAnalysis
E --> F : Completude et grounding\nscore et recommandations
F --> JSON : Analyse sourcee\npreuves et pages
F --> CSV : Scores et tracabilite RAG
F --> SYSML : Modele SysML

legend bottom
  <b>C4 - LLM + RAG + evaluation Python</b>
  <back:#E0F2FE> Extraction / RAG </back>  <back:#EDE9FE> LLM </back>
  <back:#FEF3C7> Validation </back>  <back:#ECFDF5> Evaluation </back>  <back:#DCFCE7> Export </back>
  Rectangles = traitements | Fleches = informations transmises
endlegend

@enduml
